{
  "name": "miami-launcher-ui",
  "private": true,
  "version": "1.1.1",
  "description": "Miami Launcher — каталог модов с потоковой установкой",
  "author": "MiamiLauncher",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "set VITE_DEV_SERVER_URL=http://127.0.0.1:5180 && electron .",
    "rebuild": "tsc -b && vite build && node build-exe.cjs",
    "dist": "tsc -b && vite build && electron-builder --win",
    "dist:dir": "tsc -b && vite build && electron-builder --win --dir",
    "exe": "npm run rebuild",
    "watch:exe": "node watch-exe.cjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.8",
    "@types/three": "^0.185.1",
    "@zip.js/zip.js": "^2.8.34",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.469.0",
    "puppeteer": "^25.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.miamilauncher.app",
    "productName": "MiamiLauncher",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "build-dbg1"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MiamiLauncher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Miami Launcher"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
